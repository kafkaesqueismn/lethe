{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lethe",
  "version": "0.1.0",
  "identifier": "org.lethe.messenger",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "lethe", "width": 980, "height": 680, "minWidth": 360, "minHeight": 480 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"] }
}
